{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "SpatialPointEvaluationProof",
  "type": "object",
  "properties": {
    "proof_hash": {
      "type": "string"
    },
    "query_point": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "h3_res8": {
          "type": "string"
        }
      },
      "required": [
        "lat",
        "lon",
        "h3_res8"
      ]
    },
    "target_geometry_id": {
      "type": "string"
    },
    "is_contained": {
      "type": "boolean"
    },
    "relative_position": {
      "type": "string",
      "enum": [
        "INTERIOR",
        "BOUNDARY_EDGE",
        "EXTERIOR"
      ]
    },
    "distance_to_boundary_meters": {
      "type": "number"
    }
  },
  "required": [
    "proof_hash",
    "query_point",
    "target_geometry_id",
    "is_contained",
    "distance_to_boundary_meters"
  ]
}